    {
      "name": "Idempotency",
      "description": "Idempotency-Key + request-hash collision guard. Run these in order — request #1 pins a fresh key; #2 replays it; #3 reuses it with a different payload; #4 omits it.",
      "item": [
        {
          "name": "Replay #1 — create (pins a fresh key)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pin one fixed key for the whole folder so #2/#3 can target the same logical request.",
                  "pm.collectionVariables.set('idemKey', 'idem-' + Date.now() + '-' + Math.floor(Math.random() * 1e9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('returns txId', () => pm.expect(j.txId).to.be.a('string'));",
                  "pm.collectionVariables.set('idemTxId', j.txId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"fromAccount\": \"{{alice}}\", \"toAccount\": \"{{bob}}\", \"amount\": 1234, \"reason\": \"idem demo\" }",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] }
          },
          "response": []
        },
        {
          "name": "Replay #2 — same key + same payload → same txId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 (idempotent replay)', () => pm.response.to.have.status(201));",
                  "pm.test('same txId as #1 (no new transfer)', () => {",
                  "  pm.expect(pm.response.json().txId).to.eql(pm.collectionVariables.get('idemTxId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"fromAccount\": \"{{alice}}\", \"toAccount\": \"{{bob}}\", \"amount\": 1234, \"reason\": \"idem demo\" }",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] }
          },
          "response": []
        },
        {
          "name": "Reuse — same key + different amount → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('code = idempotency_key_reuse', () => pm.expect(pm.response.json().code).to.eql('idempotency_key_reuse'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"fromAccount\": \"{{alice}}\", \"toAccount\": \"{{bob}}\", \"amount\": 9999, \"reason\": \"idem demo\" }",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] }
          },
          "response": []
        },
        {
          "name": "Missing key → 400",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Strip the auto-attached key (collection pre-request) to prove the header is required.",
                  "pm.request.headers.remove('Idempotency-Key');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('code = idempotency_key_required', () => pm.expect(pm.response.json().code).to.eql('idempotency_key_required'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"fromAccount\": \"{{alice}}\", \"toAccount\": \"{{bob}}\", \"amount\": 100, \"reason\": \"no key\" }",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] }
          },
          "response": []
        }
      ]
    }
  ]
