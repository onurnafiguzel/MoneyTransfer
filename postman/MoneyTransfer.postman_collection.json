{
  "info": {
    "_postman_id": "0e9ac1f0-0000-4000-8000-000000000001",
    "name": "MoneyTransfer — Self-Auditing Ledger (Phase 1)",
    "description": "All Phase 1 endpoints of the double-entry transfer ledger.\n\nVariables (collection scope):\n- baseUrl: API root (default http://localhost:8080)\n- alice / bob / carol: seeded account ids\n- txId: auto-captured from 'Create transfer (Alice → Bob)'\n\nTip: run 'Create transfer (Alice → Bob)' first; its test script stores the new txId so the 'Get transfer' and 'Reverse transfer' requests work automatically. The whole collection can also be run with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every POST money-movement requires an Idempotency-Key. Auto-attach a unique one so each request",
          "// is a distinct logical operation — UNLESS the request already declares its own (the Idempotency",
          "// folder pins a fixed key to prove replay/reuse, and the missing-key test removes it).",
          "if (pm.request.method === 'POST') {",
          "  const existing = pm.request.headers.find(h => h.key.toLowerCase() === 'idempotency-key');",
          "  if (!existing) {",
          "    pm.request.headers.add({ key: 'Idempotency-Key', value: 'pm-' + Date.now() + '-' + Math.floor(Math.random() * 1e9) });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "alice", "value": "11111111-1111-1111-1111-111111111111", "type": "string" },
    { "key": "bob", "value": "22222222-2222-2222-2222-222222222222", "type": "string" },
    { "key": "carol", "value": "33333333-3333-3333-3333-333333333333", "type": "string" },
    { "key": "txId", "value": "", "type": "string" },
    { "key": "idemKey", "value": "", "type": "string" },
    { "key": "idemTxId", "value": "", "type": "string" }
  ],
