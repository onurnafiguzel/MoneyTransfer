@host = http://localhost:8080

# Seeded accounts (fixed ids)
@alice = 11111111-1111-1111-1111-111111111111
@bob   = 22222222-2222-2222-2222-222222222222
@carol = 33333333-3333-3333-3333-333333333333

### health
GET {{host}}/health

### Alice balance (seeded 100000 = 1,000.00 USD)
GET {{host}}/accounts/{{alice}}/balance

### Bob balance (0)
GET {{host}}/accounts/{{bob}}/balance

### happy path: Alice -> Bob 25000 (250.00)
POST {{host}}/transfers
Content-Type: application/json

{ "fromAccount": "{{alice}}", "toAccount": "{{bob}}", "amount": 25000, "reason": "lunch" }

### Alice entries (newest first; use nextCursor for next page)
GET {{host}}/accounts/{{alice}}/entries?size=50

### deposit 5000 into Bob
POST {{host}}/deposits
Content-Type: application/json

{ "account": "{{bob}}", "amount": 5000, "reason": "top up" }

### withdraw 1000 from Alice
POST {{host}}/withdrawals
Content-Type: application/json

{ "account": "{{alice}}", "amount": 1000, "reason": "atm" }

### error: self_transfer (422)
POST {{host}}/transfers
Content-Type: application/json

{ "fromAccount": "{{alice}}", "toAccount": "{{alice}}", "amount": 100, "reason": "x" }

### error: invalid_amount (422)
POST {{host}}/transfers
Content-Type: application/json

{ "fromAccount": "{{alice}}", "toAccount": "{{bob}}", "amount": 0, "reason": "x" }

### error: currency_mismatch (422)  Alice USD -> Carol EUR
POST {{host}}/transfers
Content-Type: application/json

{ "fromAccount": "{{alice}}", "toAccount": "{{carol}}", "amount": 100, "reason": "x" }

### error: insufficient_funds (422)  Bob overspends
POST {{host}}/transfers
Content-Type: application/json

{ "fromAccount": "{{bob}}", "toAccount": "{{alice}}", "amount": 999999999, "reason": "x" }

### error: account_not_found (404)
GET {{host}}/accounts/99999999-9999-9999-9999-999999999999/balance

### reverse a transfer (replace {txId} with a real id from a POST /transfers response)
POST {{host}}/transfers/{txId}/reverse
Content-Type: application/json

{ "reason": "mistake" }

### get a transfer (replace {txId})
GET {{host}}/transfers/{txId}
