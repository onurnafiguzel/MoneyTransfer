{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ledger": "Host=localhost;Port=5432;Database=ledger;Username=ledger;Password=ledger",
    "Redis": ""
  },
  "Ledger": {
    "MaxTransfer": 1000000000000000,
    "Currencies": [ "USD", "EUR", "TRY" ],
    "ConcurrencyStrategy": "ConditionalUpdate",
    "AllowStrategyOverride": false,
    "MaxConcurrencyRetries": 8,
    "IdempotencyLockTtlSeconds": 30,
    "IdempotencyCompletedTtlSeconds": 86400
  }
}
